# Copy this file to .env and fill in your values. .env is gitignored.

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=

# Notion internal integration secret: https://www.notion.so/my-integrations
# Optional. Without it the Notion tools won't work.
# (The variable name's misspelling is intentional; the code reads it as-is.
#  NOTION_API_KEY also works.)
INTERNAL_INTERGRATION_TOKEN=

# Scheduler (optional overrides; the defaults work). Secrets are NOT set here: the PostgreSQL URL
# and the internal API token live in Windows Credential Manager (scripts\setup-scheduler.ps1).
# REDIS_URL=redis://127.0.0.1:6379
# SCHEDULER_PORT=8766
# REMINDER_GRACE_MIN=5          # a reminder up to this late still fires
# REMINDER_MISSED_NOTIFY_H=12   # later than that (up to this many hours): "missed reminder" notice
# AI_CATCHUP_MIN=60             # AI tasks later than this are recorded as missed, not run
# RECONCILE_SEC=300             # how often Redis is rebuilt from PostgreSQL
