{
  "name": "donna-scheduler",
  "private": true,
  "version": "0.1.0",
  "description": "Donna's scheduler: BullMQ queue + worker that asks the FastAPI backend to run scheduled tasks.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.10",
    "cron-parser": "^5.10.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
